[
  // 1️⃣ Fondo general del mapa (suelo/terreno)
  {
    "elementType": "geometry",
    "stylers": [{ "color": "#384054" }]  // Color de fondo general (terrenos, espacios vacíos)
  },

  // 2️⃣ Texto general (calles, barrios, ciudades)
  {
    "elementType": "labels.text.fill",
    "stylers": [{ "color": "#EFEFED" }]  // Color del texto general
  },
  {
    "elementType": "labels.text.stroke",
    "stylers": [{ "color": "#828586" }]  // Contorno del texto general
  },

  // 3️⃣ Texto de localidades (ciudades/pueblos)
  {
    "featureType": "administrative.locality",
    "elementType": "labels.text.fill",
    "stylers": [{ "color": "#BEBFC2" }]  // Color del texto de ciudades/pueblos
  },

  // 4️⃣ Puntos de interés generales (POI)
  {
    "featureType": "poi",
    "stylers": [{ "visibility": "off" }]  // Oculta POI como negocios, museos, restaurantes
  },

  // 5️⃣ Parques
  {
    "featureType": "poi.park",
    "elementType": "geometry",
    "stylers": [{ "visibility": "on" }, { "color": "#4B615F" }]  // Color de parques
  },
  {
    "featureType": "poi.park",
    "elementType": "labels",
    "stylers": [{ "visibility": "off" }]  // Oculta el nombre del parque
  },

  // 6️⃣ Calles
  {
    "featureType": "road",
    "elementType": "geometry",
    "stylers": [{ "color": "#5D647D" }]  // Color del pavimento de calles normales
  },
  {
    "featureType": "road",
    "elementType": "geometry.stroke",
    "stylers": [{ "color": "#27303D" }]  // Contorno de las calles
  },
  {
    "featureType": "road",
    "elementType": "labels.text.fill",
    "stylers": [{ "color": "#EFEFED" }]  // Color del texto de calles
  },
  {
    "featureType": "road",
    "elementType": "labels.text.stroke",
    "stylers": [{ "color": "#828586" }]  // Contorno del texto de calles
  },

  // 7️⃣ Carreteras principales / highways
  {
    "featureType": "road.highway",
    "elementType": "geometry",
    "stylers": [{ "color": "#5D647D" }]  // Pavimento de carreteras principales
  },
  {
    "featureType": "road.highway",
    "elementType": "geometry.stroke",
    "stylers": [{ "color": "#605167" }]  // Contorno de carreteras principales
  },
  {
    "featureType": "road.highway",
    "elementType": "labels.text.fill",
    "stylers": [{ "color": "#f3d19c" }]  // Texto de carreteras principales
  },

  // 8️⃣ Transporte / estaciones
  {
    "featureType": "transit",
    "elementType": "geometry",
    "stylers": [{ "color": "#605167" }]  // Color de rutas de transporte
  },
  {
    "featureType": "transit.station",
    "elementType": "labels.text.fill",
    "stylers": [{ "color": "#d59563" }]  // Texto de estaciones
  },

  // 9️⃣ Agua
  {
    "featureType": "water",
    "elementType": "geometry",
    "stylers": [{ "color": "#2A3C56" }]  // Color de ríos, lagos y mares
  },
  {
    "featureType": "water",
    "elementType": "labels.text.fill",
    "stylers": [{ "color": "#515c6d" }]  // Texto sobre el agua (ej. nombres de ríos)
  },
  {
    "featureType": "water",
    "elementType": "labels.text.stroke",
    "stylers": [{ "color": "#17263c" }]  // Contorno del texto sobre el agua
  },

  // 🔟 Urbanizaciones / áreas residenciales
  {
    "featureType": "landscape.man_made",
    "elementType": "geometry",
    "stylers": [{ "color": "#384054" }]  // Color de las casas, edificios y urbanizaciones
  },
  {
    "featureType": "landscape.man_made",
    "elementType": "labels.text.fill",
    "stylers": [{ "color": "#667191" }]  // Texto dentro de urbanizaciones si existiera
  },
  {
    "featureType": "landscape.man_made",
    "elementType": "labels.text.stroke",
    "stylers": [{ "color": "#7A7D80" }]  // Contorno del texto de urbanizaciones
  }
]

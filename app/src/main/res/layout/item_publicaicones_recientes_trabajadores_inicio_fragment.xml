<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="310dp"
    android:layout_height="200dp"
    android:layout_marginLeft="7dp"
    >

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="300dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="314dp" />

    <RelativeLayout
        android:id="@+id/realtive_clikc"
        android:layout_width="310dp"
        android:layout_height="200dp"
        app:layout_constraintEnd_toStartOf="@id/guideline_end"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="310dp"
            android:layout_height="200dp"
            android:layout_marginRight="10dp"
            android:orientation="horizontal">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:id="@+id/carga_contenido"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_publicidad"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"

                android:src="@drawable/cargando_img_geinz_500"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:background="@drawable/mascara_servicios_ofertas_etc" />

        <TextView
            android:id="@+id/contenidoPublicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/cat"
            android:textColor="@color/white" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_alignParentRight="true"
            android:layout_margin="15dp">
            <ProgressBar
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:id="@+id/cargaimg"/>


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgPerfil"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/img_perfil" />

            <ImageView
                android:id="@+id/verificado"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|bottom"
                android:visibility="gone"
                android:src="@drawable/icon_verificado"/>
        </FrameLayout>

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

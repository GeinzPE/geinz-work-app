<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/listener"
    style="@style/RoundTrabajadoresBG"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="5dp">

        <TextView
            android:id="@+id/dispo_actual"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextoModoOScuroColor"
            android:textSize="15sp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/fuente_para_texto_special_gothic"
            android:textStyle="bold"
            android:text="Dispositivo Actaul"/>

        <TextView
            android:id="@+id/dispositivo"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/fuente_para_texto_special_gothic"
            android:text="@string/cat"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/hora"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/fuente_para_texto_special_gothic"
            android:text="@string/cat"
            android:textSize="15sp" />

        <TextView
            android:layout_marginBottom="5dp"
            android:id="@+id/fecha"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fuente_para_texto_special_gothic"
            android:text="@string/cat"
            android:textSize="15sp" />

        <TextView
            android:layout_marginBottom="5dp"
            android:id="@+id/dispositivo_primario"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fuente_para_texto_special_gothic"
            android:text="@string/cat"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/marca_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="10dp" />

</LinearLayout>
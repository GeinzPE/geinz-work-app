<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/fondo"
    android:layout_width="200dp"
    android:layout_height="310dp"
    android:layout_marginVertical="10dp"
    android:layout_marginRight="10dp"
    app:cardBackgroundColor="@color/roundcustom"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:elevation="10dp">
        <!-- Imagen principal -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_trabajo"
            android:layout_width="200dp"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

        <ProgressBar
            android:id="@+id/progress_carga_imagen"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/descuentoPorcentaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/roun_off_descuento"
            android:padding="5dp"
            android:text="@string/cat"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/envio_grtis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/roun_verde_descuento"
            android:padding="5dp"
            android:text="Envio gratis"

            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/cargadoContenido"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@+id/img_trabajo"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/linealCargandoDatos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/img_trabajo"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/nombreProducto"
                style="@style/TextoModoOScuroColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/cat"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nombreProducto"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/precioProducto"
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/cat"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/precioDescuento"
                    style="@style/descripcionColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/cat"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>


        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.geinzwork.vistaTrabajador.ver_productos_publicados">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="10dp"
                    android:layout_marginLeft="5dp"
                    android:fontFamily="@font/anton_regular"
                    android:text="Edita o elimina tus publicaciones"
                    android:textSize="20sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/todos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Todos" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mas_clicks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mas clicks"
                            app:chipIcon="@drawable/clicks_icon_webp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mas_Vistas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mas vistas"
                            app:chipIcon="@drawable/vistar_icon_webp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mas_compartidas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mas compartidas"
                            app:chipIcon="@drawable/compartir_icon_webp" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recicle_productos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.geinzwork.vistas_principales.tu_trabajo_habla_porti">

    <androidx.core.widget.NestedScrollView
        style="@style/fondo"
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                style="@style/TextoModoOScuroColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/titulo_roboto_extra_bold_fuente"
                android:text="Tu trabajo habla por ti "
                android:textSize="25sp" />

            <TextView
                style="@style/TextoModoOScuroColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fuente_para_texto_special_gothic"
                android:text="Cada vez que completes un trabajo de manera exitosa, recuerda la importancia de invitar al cliente a dejar una reseña positiva en tu perfil."
                android:textSize="16sp" />

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="wrap_content"
                android:layout_height="300dp"
                android:layout_marginVertical="10dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/review_animaciones" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieView"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginVertical="10dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/estrellas_calificacion_animation" />

            <TextView
                style="@style/TextoModoOScuroColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/fuente_para_texto_special_gothic"
                android:text="Estas valoraciones son fundamentales para construir una reputación sólida y confiable dentro de Geinz Work. Las reseñas positivas te ayudarán a destacar entre otros profesionales, a aumentar tu visibilidad en las búsquedas y, en última instancia, a acceder a más y mejores oportunidades laborales en tu localidad."
                android:textSize="16sp" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</LinearLayout>
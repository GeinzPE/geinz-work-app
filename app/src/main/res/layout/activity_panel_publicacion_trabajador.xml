<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.geinzwork.fragmentos.panel_publicacion_trabajador">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrool_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
      >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/titulo_texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"

                    android:text="Panel de publicacion"
                    android:textSize="25sp" />

                <ImageView
                    android:id="@+id/menu_acceso_directo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/menu_puntos" />
            </RelativeLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/fuente_para_texto_special_gothic"
                android:text="Desde aquí puedes agregar tus trabajos recientes,crear publicaciones y mostrar tus productos. Comparte lo mejor de lo que haces en Geinz Work y conecta con más clientes."
                android:textSize="13sp" />


            <include
                android:id="@+id/traajos_recientes"
                layout="@layout/include_panel_publicaciones" />

            <include
                android:id="@+id/publicaciones"
                layout="@layout/include_panel_publicaciones" />

            <include
                android:id="@+id/productos_venta"
                layout="@layout/include_panel_publicaciones" />

            <LinearLayout
                android:id="@+id/agregar_redes_sociales"
                style="@style/RoundTrabajadoresBG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_redes"
                        android:layout_width="wrap_content"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/agrega_redes_sociales"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />


                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="7dp">

                        <TextView
                            style="@style/TextoModoOScuroColor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="sans-serif"
                            android:text="AGREGA TUS REDES SOCIALES COMO FACEBOOK, INSTAGRAM Y TIKTOK"
                            android:textAllCaps="true"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:paddingHorizontal="7dp">


                                <TextView
                                    style="@style/TextoModoOScuroColor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_marginEnd="8dp"
                                    android:layout_marginBottom="10dp"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif"
                                    android:maxLines="4"
                                    android:text="Mostrar tus redes sociales genera confianza y puede abrirte más oportunidades laborales dentro de Geinz Work."
                                    android:textSize="12sp"
                                    android:textStyle="bold" />


                            </RelativeLayout>


                        </LinearLayout>


                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/metodo_numero_nombre"
                style="@style/RoundTrabajadoresBG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_servicio"
                        android:layout_width="wrap_content"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/nombre_numero_metodos"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />


                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="7dp">

                        <TextView
                            style="@style/TextoModoOScuroColor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="sans-serif"
                            android:text="Agrega tu numero de yape,plin,transferencia"
                            android:textAllCaps="true"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:paddingHorizontal="7dp">


                                <TextView
                                    style="@style/TextoModoOScuroColor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_marginEnd="8dp"
                                    android:layout_marginBottom="10dp"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif"
                                    android:maxLines="4"
                                    android:text="Agrega tu nombre y numero de pago para facilitar tu creacion de metodos de pago en geinz work "
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </RelativeLayout>


                        </LinearLayout>


                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/panel_metoods"
                layout="@layout/include_panel_publi_vertical" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <RelativeLayout
        android:visibility="gone"
        android:id="@+id/sin_registro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <TextView
            android:id="@+id/textViewMessage"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:text="¡Has cerrado sesión en GeinzWork!"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView

            android:id="@+id/textViewInstructions"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewMessage"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="32dp"
            android:text="Para continuar, por favor, inicia sesión nuevamente."
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/iniciar_seccion"
            style="@style/RoundedButton"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_below="@+id/textViewInstructions"
            android:layout_centerHorizontal="true"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:text="Inicia sesión"
            android:textSize="14sp"
            app:iconGravity="textEnd" />
    </RelativeLayout>


</RelativeLayout>
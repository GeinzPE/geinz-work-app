<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:id="@+id/cerrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="8dp" />

            <LinearLayout
                android:id="@+id/vistra_previa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextoTitulos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"
                    android:text="Informacion previa del trabajador"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_portada"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sin_foto_portada_con_marca"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cargando_img"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/img_perfil"
                        android:layout_width="90dp"
                        android:layout_height="90dp"

                        android:layout_alignParentBottom="true"
                        android:src="@drawable/img_perfil" />
                </RelativeLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/nombre_apellido"
                            style="@style/TextoModoOScuroColor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginRight="10dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/titulo_roboto_extra_bold_fuente"
                            android:maxLines="1"
                            android:text="@string/cat"
                            android:textSize="22sp" />


                        <ImageView
                            android:id="@+id/icono_verificado"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginRight="10dp"
                            android:layout_toRightOf="@+id/nombre_apellido"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/verificadoTXT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </RelativeLayout>

                </LinearLayout>


                <TextView
                    android:id="@+id/localidad_nacionaliad"
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/fuente_para_texto_special_gothic"
                    android:maxLines="2"
                    android:text="@string/cat"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/categoria"
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/fuente_para_texto_special_gothic"
                    android:maxLines="2"
                    android:text="@string/cat"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/subcategoria_trabajador"
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/fuente_para_texto_special_gothic"
                    android:maxLines="2"
                    android:text="@string/cat"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/total_estrellas"
                        style="@style/TextoModoOScuroColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/fuente_para_texto_special_gothic"
                        android:text="@string/cat"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="10dp"
                        android:src="@drawable/start_icon_dravalbe" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/siguiendo"
                        style="@style/TextoModoOScuroColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/fuente_para_texto_special_gothic"
                        android:text="@string/cat"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/seguidores"
                        style="@style/TextoModoOScuroColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="10dp"
                        android:fontFamily="@font/fuente_para_texto_special_gothic"
                        android:text="@string/cat"
                        android:textSize="15sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/seguir"
                        style="@style/RoundedButtonTrabajador"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:layout_marginRight="5dp"
                        android:layout_weight="3"
                        android:text="Seguir "
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/siguiendo_btn"
                        style="@style/RoundedButtonTrabajador"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:layout_marginRight="5dp"
                        android:layout_weight="3"
                        android:background="@drawable/bordes_btn_sigueindo_trabajador"
                        android:text="siguiendo "
                        android:textColor="@color/white"
                        android:visibility="gone" />


                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/ver_perfil"
                        style="@style/RoundedButtonTrabajador"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="3"
                        android:text="Ver perfil" />





                    <RelativeLayout
                        android:layout_marginLeft="10dp"
                        android:layout_gravity="center"
                        android:id="@+id/guardar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_bakc_preset"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="15dp">

                        <ImageView
                            android:layout_centerInParent="true"
                            android:padding="3dp"
                            android:id="@+id/save_imageview"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/save_icon" />

                        <com.airbnb.lottie.LottieAnimationView
                            android:layout_centerInParent="true"

                            android:layout_gravity="center"
                            android:padding="3dp"
                            android:id="@+id/save"
                            android:layout_width="35dp"
                            android:layout_height="35dp" />
                    </RelativeLayout>


                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cargar_lineal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginVertical="20dp"
                android:gravity="center"
                android:orientation="vertical">


                <ProgressBar
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginBottom="5dp" />

                <TextView
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fuente_para_texto_special_gothic"
                    android:text="cargando_cotenido..."
                    android:textSize="16sp" />

            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
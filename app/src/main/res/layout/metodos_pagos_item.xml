<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/listener"
    style="@style/RoundTrabajadoresBG"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginVertical="10dp"
    android:orientation="vertical">


    <LinearLayout
        android:layout_weight="1"
        android:layout_marginVertical="5dp"
        android:padding="5dp"
        android:id="@+id/linealMetodos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titulo_referencia"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat" />

        <TextView
            android:id="@+id/metodos_pagos_selecionadso"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo_plin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="5dp"
                android:src="@drawable/logo_plin"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/logo_yape"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="5dp"
                android:src="@drawable/yape_logo"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/logo_efectivo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="5dp"
                android:src="@drawable/efectivo_logo"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/logo_transferencia"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="5dp"
                android:src="@drawable/transferencia_icon"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
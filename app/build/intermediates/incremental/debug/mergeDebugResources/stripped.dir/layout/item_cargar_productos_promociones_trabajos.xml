<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/linealMostrarTrabajos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cambiarTexto_trabajos_realziados_trabajos_recientes"
                style="@style/TextoTitulos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/cat"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/verTodosTrabajos"
                style="@style/VioletaColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ver todos" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/cargando_contenido"
                android:layout_width="40dp"
                android:layout_marginTop="50dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"/>

            <androidx.recyclerview.widget.RecyclerView
                android:visibility="gone"
                android:id="@+id/mas_trabajos_realiados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <RelativeLayout
                android:visibility="gone"
                android:id="@+id/linealNo_seEncontraron"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_height="220dp">

                <TextView
                    android:id="@+id/texto_cambiar_trabajos_o_publicaciones"
                    android:textStyle="bold"
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="No se econtro trabajos realizados"
                    android:textSize="17sp" />
            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>
</LinearLayout>
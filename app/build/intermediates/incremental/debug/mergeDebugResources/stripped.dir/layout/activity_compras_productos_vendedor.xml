<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.geinzwork.fragmentos.productosPublicadosVista.compras_productos_vendedor">

    <LinearLayout
        android:id="@+id/linealCarga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/cargandoContenido"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center" />

        <TextView
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="Espere un momento mientras cargamos sus datos...."
            android:textSize="15sp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/netScroolView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextoTitulos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nº Producto"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/codigoGeneradoCompra"
                    style="@style/TextoTitulos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textSize="20sp" />
            </LinearLayout>


            <TextView
                style="@style/TextoTitulos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle del producto"
                android:textSize="16sp" />

            <include
                android:id="@+id/categoriaProductos"
                layout="@layout/include_texto_horizontal_general" />

            <include
                android:id="@+id/marcaProducto"
                layout="@layout/include_texto_horizontal_general" />

            <include
                android:id="@+id/modeloProducto"
                layout="@layout/include_texto_horizontal_general" />

            <include
                android:id="@+id/StokDiponible"
                layout="@layout/include_texto_horizontal_general" />

            <include
                android:id="@+id/garantiaProducto"
                layout="@layout/include_texto_horizontal_general" />

            <include
                android:id="@+id/condicionProducto"
                layout="@layout/include_texto_horizontal_general" />

            <include
                android:id="@+id/MetodoEntregaProducto"
                layout="@layout/include_texto_horizontal_general" />

            <LinearLayout
                android:id="@+id/linealMetodoEntrega"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextoTitulos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Metodo Entrega"
                    android:textSize="16sp" />

                <TextView
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Geinz se encargará de la entrega del producto utilizando la referencia
primaria y secundaria proporcionada en el formulario de envío."
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/linealRecicleCargandoRerf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/ver_lugares_entrega"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/linealCargandoRef"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ProgressBar
                                android:id="@+id/cargandoRef"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center" />

                            <TextView
                                android:id="@+id/cargandoText"
                                style="@style/TextoModoOScuroColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="10dp"
                                android:text="Cargando referencias.."
                                android:textSize="15sp" />

                        </LinearLayout>

                    </RelativeLayout>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/crea_direccion"
                        style="@style/RoundedButton"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:text="Crear Direccion nueva"
                        android:textSize="14sp"
                        app:iconGravity="textEnd" />
                </LinearLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/direccionEntrega"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp">

                    <EditText
                        android:id="@+id/direccionEntregaED"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        android:hint="Direccion de entrega "
                        android:inputType="text"
                        android:paddingLeft="10dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ReferenciaEntrega"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp">

                    <EditText
                        android:id="@+id/ReferenciaEntregaED"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        android:hint="Referencia de entrega "
                        android:inputType="text"
                        android:paddingLeft="10dp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <TextView
                android:id="@+id/lat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/TexviewIDRefDire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoTitulos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="cantidad a comprar"
                    android:textSize="16sp" />

                <TextView
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indique la cantidad que desea adquirir. Tenga en cuenta que no debe superar el stock disponible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/round_btn_carrito_cantidad"
                    android:orientation="horizontal">


                    <ImageButton
                        android:id="@+id/menos"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="@drawable/round_btn_carrito_cantidad"
                        android:maxWidth="20dp"
                        android:maxHeight="20dp"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_menos"
                        app:layout_collapseMode="pin" />

                    <TextView
                        android:id="@+id/cantidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/mas"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:background="@drawable/round_btn_carrito_cantidad"
                        android:maxWidth="20dp"
                        android:maxHeight="20dp"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_mas"
                        app:layout_collapseMode="pin" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoTitulos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Descripcion del producto"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/descripcionProducto"
                    style="@style/TextoModoOScuroColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:text="@string/cat" />

                <TextView
                    android:id="@+id/tvReadMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Leer más"
                    android:textColor="#027EB5"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>


            <TextView
                style="@style/TextoTitulos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Total a cancelar"
                android:textSize="16sp" />

            <include
                android:id="@+id/precioproducto"
                layout="@layout/include_texto_horizontal_general" />

            <include
                android:id="@+id/precioDelivery"
                layout="@layout/include_texto_horizontal_general" />

            <include
                android:id="@+id/totalcancelar"
                layout="@layout/include_texto_horizontal_general" />

            <TextView
                style="@style/TextoTitulos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Datos del usuario"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nombresCompletos"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <EditText

                    android:id="@+id/nombresCompletosED"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/nombre_fre"
                    android:inputType="text"
                    android:paddingLeft="10dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dni"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <EditText

                    android:id="@+id/dniED"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="DNI"
                    android:inputType="number"
                    android:paddingLeft="10dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/Numero_de_contacto"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <EditText
                    android:id="@+id/Numero_de_contactoED"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Numero de contacto"
                    android:inputType="number"
                    android:paddingLeft="10dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextoTitulos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Metodos del pago aceptados"
                android:textSize="16sp" />

            <TextView
                style="@style/TextoModoOScuroColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="El comprador y el vendedor acordarán los detalles del pago de manera directa a través de WhatsApp antes de confirmar la compra."
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/radioGrupMetodosPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/metodoYape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="yape"
                    android:visibility="gone" />

                <RadioButton
                    android:id="@+id/metodoPlin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="plin"
                    android:visibility="gone" />

                <RadioButton
                    android:id="@+id/metodoEfectivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="efectivo"
                    android:visibility="gone" />

            </RadioGroup>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/comfirmar_compra"
                    style="@style/RoundedButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1"
                    android:text="confirmar compra"
                    android:textSize="14sp"
                    app:iconGravity="textEnd" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelar_compra"
                    style="@style/RoundedButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1"
                    android:text="cancelar compra"
                    android:textSize="14sp"
                    app:iconGravity="textEnd" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</RelativeLayout>
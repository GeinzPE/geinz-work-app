<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".fragmentos.info">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/linealappLayout"
        style="@style/fondo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="10dp">

                        <ImageView
                            android:id="@+id/qrTrabajador"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_alignParentRight="true"
                            android:layout_margin="10dp"
                            android:src="@drawable/qr_icon_color" />

                        <ImageView
                            android:id="@+id/popup"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_margin="10dp"
                            android:src="@drawable/menu_puntos" />

                        <TextView
                            style="@style/TextoTitulos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/uni_sans"
                            android:text="Informacion Principal"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            tools:ignore="MissingConstraints" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="210dp">


                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/relativeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            app:cardCornerRadius="0dp"
                            app:shapeAppearanceOverlay="@style/BottomCutShape"
                            app:strokeWidth="0dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">


                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/imgPortada"
                                    android:layout_width="match_parent"
                                    android:layout_height="200dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/sin_foto_portada_con_marca" />

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/progress_carga_imagen_fondo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:indeterminate="true"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/overlay"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#4D000000" /> <!-- El color #80000000 es negro con un 50% de opacidad -->
                            </FrameLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/round_encabezado" />

                        </com.google.android.material.card.MaterialCardView>


                        <FrameLayout
                            android:id="@+id/circle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginHorizontal="10dp">


                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/img_PerfilUser"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/img_perfil"
                                app:civ_border_color="@color/black"
                                app:civ_border_width="1dp" />

                            <View
                                android:id="@+id/estado"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginTop="20dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/dot" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progress_carga_imagen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:visibility="gone" />


                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linealRedes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="10dp"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="22dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/ig"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_marginHorizontal="5dp"
                                android:src="@drawable/instagram_icon" />

                            <ImageView
                                android:id="@+id/fb"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_marginHorizontal="5dp"
                                android:src="@drawable/facebook_icon" />

                            <ImageView
                                android:id="@+id/tk"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_marginHorizontal="5dp"
                                android:src="@drawable/tik_tok_icon" />

                        </LinearLayout>
                    </RelativeLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/round_encabezado"
                        android:orientation="vertical"
                        android:padding="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/relativeLayout">

                        <LinearLayout
                            android:id="@+id/innerRelativeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/round_encabezado"
                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:orientation="horizontal">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">

                                    <TextView
                                        android:id="@+id/nombre"
                                        style="@style/TextoTitulos"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/cat"
                                        android:textSize="25sp"
                                        android:textStyle="bold" />



                                    <ImageView
                                        android:id="@+id/verificado"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:layout_marginLeft="5dp"
                                        android:layout_toRightOf="@+id/nombre"
                                        android:src="@drawable/icon_verificado"
                                        android:visibility="gone" />

                                    <TextView
                                        android:id="@+id/verificadoTXT"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </RelativeLayout>

                                <ImageView
                                    android:id="@+id/notificaciones"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginHorizontal="10dp"
                                    android:src="@drawable/notification_off"
                                    android:visibility="gone" />
                            </LinearLayout>
                            <TextView
                                style="@style/descripcionColor"
                                android:textSize="12sp"
                                android:fontFamily="@font/fuente_para_texto_special_gothic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/nombre_usuario"/>


                            <TextView
                                android:id="@+id/telefono"
                                style="@style/TextoModoOScuroColor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cat"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/categoria_tipo_trabajo"
                                style="@style/TextoModoOScuroColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginRight="20dp"
                                android:text="****"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/descripcionTrabajador"
                                style="@style/TextoModoOScuroColor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="0sp" />

                            <LinearLayout
                                android:id="@+id/linealContenidoDesctipcion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/caracteristica1"
                                    style="@style/TextoModoOScuroColor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="20dp"
                                    android:ellipsize="end"
                                    android:maxLines="3"
                                    android:text="@string/cat"
                                    android:textSize="12sp" />
                                <!-- Botón "Leer más" -->
                                <TextView
                                    android:id="@+id/tvReadMore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Leer más"
                                    android:textColor="#027EB5"
                                    android:textSize="12sp"
                                    android:textStyle="normal"

                                    android:visibility="gone" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/location_drawable" />

                                <TextView
                                    android:id="@+id/localidad_user"
                                    style="@style/TextoModoOScuroColor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="5dp"
                                    android:fontFamily="@font/fuente_para_texto_special_gothic"
                                    android:text="@string/cat" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_marginBottom="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/baseline_calendar_month_24" />

                                <TextView
                                    android:id="@+id/fechaCreacionCuenta"
                                    style="@style/descripcionColor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="5dp"
                                    android:fontFamily="@font/fuente_para_texto_special_gothic"
                                    android:text="@string/cat" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/linealSiguiendo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/siguiendo"
                                        style="@style/TextoModoOScuroColor"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginTop="5dp"
                                        android:text="0"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        style="@style/descripcionColor"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginTop="5dp"
                                        android:text="@string/siguiendo"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/linealSeguidores"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/segidores"
                                        style="@style/TextoModoOScuroColor"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginTop="5dp"
                                        android:text="0"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        style="@style/descripcionColor"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginTop="5dp"
                                        android:text="@string/seguidores"
                                        android:textSize="14sp" />
                                </LinearLayout>


                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/BtnSeguimiento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">


                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/dejarDeSeguirOSeguir"
                                    style="@style/RoundedButtonTrabajador"
                                    android:layout_width="wrap_content"
                                    android:layout_height="35dp"
                                    android:layout_marginRight="5dp"
                                    android:layout_weight="3"
                                    android:text="Seguir Trabajador" />

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/mas_informacion"
                                    style="@style/RoundedButtonTrabajador"
                                    android:layout_width="wrap_content"
                                    android:layout_height="35dp"
                                    android:layout_marginHorizontal="5dp"
                                    android:layout_weight="3"
                                    android:text="Más información" />

                                <RelativeLayout
                                    android:id="@+id/mostrarSeguridos"
                                    style="@style/RoundedButtonTrabajador"
                                    android:layout_width="40dp"
                                    android:layout_height="35dp"
                                    android:layout_marginHorizontal="5dp">


                                    <ImageView
                                        android:id="@+id/mostrarSeguridosIMG"
                                        android:layout_width="40dp"
                                        android:layout_height="35dp"
                                        android:layout_centerInParent="true"
                                        android:src="@drawable/vector_icon_mas_trabjadores" />

                                    <ProgressBar
                                        android:id="@+id/cargadoSugeridos"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:layout_centerInParent="true"
                                        android:visibility="gone" />
                                </RelativeLayout>


                            </LinearLayout>


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linealtrabajadoresGeinz"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextoTitulos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="10dp"
                                    android:layout_weight="1"
                                    android:text="Mas trabajadores Geinz"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/ver_mas_trabajadores"
                                    style="@style/VioletaColor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="15dp"
                                    android:text="ver todos" />
                            </LinearLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="10dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/trabajadores_similares"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:nestedScrollingEnabled="false" />

                                <RelativeLayout
                                    android:id="@+id/no_se_encontraron_trabajadores"
                                    android:layout_width="match_parent"
                                    android:layout_height="220dp"
                                    android:visibility="gone">

                                    <TextView
                                        style="@style/TextoModoOScuroColor"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:text="No se econtraron trabajadores"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />
                                </RelativeLayout>

                            </RelativeLayout>
                        </LinearLayout>


                        <TextView
                            style="@style/TextoTitulos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_marginTop="10dp"
                            android:text="Trabajos Recientes"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextoModoOScuroColor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:layout_marginTop="7dp"
                            android:layout_marginRight="25dp"
                            android:text="Descubre los trabajadores más destacados por sus trabajos recientes, quienes se han ganado la confianza por su excelente desempeño en los últimos proyectos."
                            android:textSize="12sp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="242dp">

                            <org.imaginativeworld.whynotimagecarousel.ImageCarousel
                                android:id="@+id/carrusel"
                                android:layout_width="match_parent"
                                android:layout_height="239dp"
                                android:layout_marginVertical="5dp"
                                android:layout_marginLeft="5dp"
                                android:layout_marginTop="16dp"
                                app:autoWidthFixing="false"
                                app:carouselGravity="START"
                                app:carouselType="SHOWCASE"
                                app:imageScaleType="center"
                                app:infiniteCarousel="false"
                                app:scaleOnScroll="false"
                                app:showBottomShadow="false"
                                app:showCaption="false"
                                app:showIndicator="false"
                                app:showNavigationButtons="false"
                                app:showTopShadow="false" />

                            <TextView
                                android:id="@+id/no_se_encontraron_trabajos"
                                style="@style/TextoModoOScuroColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="No se econtraron trabajos realizados"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </RelativeLayout>

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/linealTrabajosRealziados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/baner_publicaciones_recientes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextoTitulos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="7dp"
                                    android:layout_marginTop="10dp"
                                    android:text="Publicaciones mas recientes del trabajador"
                                    android:textSize="20sp" />

                                <TextView
                                    style="@style/TextoModoOScuroColor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="7dp"
                                    android:layout_marginVertical="10dp"
                                    android:layout_marginRight="25dp"
                                    android:text="Descrubre toda las publicaciones y ofertas disponibles del Trabajador verificado"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/Trabajos_realizados"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp"
                                    android:nestedScrollingEnabled="false" />

                                <RelativeLayout
                                    android:id="@+id/no_se_encontro_publicaciones"
                                    android:layout_width="match_parent"
                                    android:layout_height="220dp"
                                    android:visibility="gone">

                                    <TextView
                                        style="@style/TextoModoOScuroColor"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:text="No se econtraron publicaciones realizados"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />
                                </RelativeLayout>

                            </RelativeLayout>

                        </LinearLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/lineal_productos_publicados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextoTitulos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="9dp"
                                android:text="Productos"
                                android:textSize="20sp" />

                            <TextView
                                style="@style/TextoModoOScuroColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="9dp"
                                android:layout_marginVertical="5dp"
                                android:layout_marginBottom="10dp"
                                android:text="Explora los productos más recientes ofrecidos por nuestros profesionales."
                                android:textSize="12sp" />


                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/productosDestacados"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="7dp"
                                android:layout_marginTop="5dp" />

                        </LinearLayout>

                        <RelativeLayout
                            android:id="@+id/linealNo_seEncontraron"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:visibility="gone">

                            <TextView
                                style="@style/TextoModoOScuroColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="No se encontro productos publicados"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </RelativeLayout>


                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


    </com.google.android.material.appbar.AppBarLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/buttonNavigation"
        app:shimmer_auto_start="true">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <include layout="@layout/carga_tiendas" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.facebook.shimmer.ShimmerFrameLayout>

</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context="com.example.geinzwork.vistaTrabajador.vista_ver_productos_trabajadores">

    <LinearLayout
        android:id="@+id/cargandoContenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp" />

        <TextView
            style="@style/titulo_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cargandoContenido"
            android:layout_centerInParent="true"
            android:layout_marginTop="10dp"
            android:text="@string/cargandoContenido"
            android:textSize="15sp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/containerDatos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/carrucelImgProductosVentaUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/campos_productos_user_verificados"
                layout="@layout/include_campos_productos_vendidos_verificados" />


            <include
                android:id="@+id/perfiltrabajador"
                layout="@layout/item_perfil_trabajador" />


            <include
                android:id="@+id/cargaProductos_promo_trabajos"
                layout="@layout/item_cargar_productos_promociones_trabajos" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="200dp"
    app:cardElevation="8dp"
    style="@style/fondo"
    android:layout_height="300dp">


<RelativeLayout
    android:layout_width="200dp"
    android:layout_height="300dp">
    <RelativeLayout
        android:id="@+id/realitveCardView"
        android:layout_width="200dp"
        android:layout_height="250dp">

        <androidx.cardview.widget.CardView
            android:layout_width="200dp"
            android:layout_height="250dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="8dp"> <!-- Ajusta el radio de las esquinas según sea necesario -->

            <io.getstream.photoview.PhotoView
                android:id="@+id/image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>


    </RelativeLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_carga_imagen"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/descuentoPorcentaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_gravity="center"
        android:layout_margin="15dp"
        android:background="@drawable/roun_off_descuento"
        android:padding="5dp"
        android:text="@string/cat"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nombreProducto"
        style="@style/TextoModoOScuroColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/realitveCardView"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginLeft="10dp"
        android:text="@string/cat"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_marginLeft="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/nombreProducto"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/precioProducto"
            style="@style/TextoModoOScuroColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/cat"
            android:textStyle="bold" />

        <TextView
            android:visibility="gone"
            android:id="@+id/precioDescuento"
            style="@style/descripcionColor"
            android:layout_marginLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/cat"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>




</androidx.cardview.widget.CardView>
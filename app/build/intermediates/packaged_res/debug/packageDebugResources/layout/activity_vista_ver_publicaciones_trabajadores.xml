<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context="com.example.geinzwork.vistaTrabajador.vista_ver_publicaciones_trabajadores">

    <LinearLayout
        android:id="@+id/cargandoContenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp" />

        <TextView
            style="@style/titulo_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cargandoContenido"
            android:layout_centerInParent="true"
            android:layout_marginTop="10dp"
            android:text="@string/cargandoContenido"
            android:textSize="15sp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contenido_cargado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:padding="5dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/retroceder"
                android:layout_width="40dp"
                android:layout_marginTop="5dp"
                android:layout_height="40dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/circle_bakc_preset"
                android:maxWidth="20dp"
                android:maxHeight="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/back_preset_retro" />


            <org.imaginativeworld.whynotimagecarousel.ImageCarousel
                android:id="@+id/carrucel_publicaciones_recientes_img"
                android:layout_width="match_parent"
                android:layout_height="239dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                app:autoPlay="true"
                app:autoPlayDelay="10000"
                app:autoWidthFixing="false"
                app:carouselGravity="START"
                app:carouselType="SHOWCASE"
                app:imageScaleType="centerCrop"
                app:infiniteCarousel="false"
                app:scaleOnScroll="false"
                app:showBottomShadow="false"
                app:showCaption="false"
                app:showIndicator="false"
                app:showNavigationButtons="false"
                app:showTopShadow="false" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/titulo"
        style="@style/titulo_texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/cat" />

    <ImageView
        android:id="@+id/compartir_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginHorizontal="10dp"
        android:layout_gravity="center"
        android:src="@drawable/compartir_drawable" />

</LinearLayout>


            <TextView
                android:id="@+id/descripcion_publicacion"
                style="@style/TextoModoOScuroColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="@string/cat" />

            <TextView
                android:id="@+id/tvReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leer más"
                android:textColor="#027EB5"
                android:textSize="12sp"
                android:textStyle="normal"
                android:visibility="gone" />


            <include
                android:id="@+id/cargaPublicaicones_realizadas"
                layout="@layout/item_cargar_productos_promociones_trabajos" />

            <include
                android:id="@+id/perfiltrabajador"
                layout="@layout/item_perfil_trabajador" />


            <include
                android:id="@+id/cargaProductos_promo_trabajos"
                layout="@layout/item_cargar_productos_promociones_trabajos" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>



</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="20dp"

    android:layout_marginBottom="30dp"
    android:layout_height="280dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"

        android:orientation="horizontal">

        <TextView
            style="@style/TextoTitulos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/geinz"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/verdesarrollo"
            style="@style/VioletaColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="ver todos" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="280dp">
        <ProgressBar
            android:visibility="gone"

            android:id="@+id/progressvar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"/>
        <androidx.recyclerview.widget.RecyclerView
            android:visibility="gone"
            android:id="@+id/productos"
            android:layout_width="match_parent"
            android:clickable="true"
            android:layout_height="280dp" />
        <TextView
            android:visibility="gone"
            android:layout_centerInParent="true"
            style="@style/TextoModoOScuroColor"
            android:textStyle="bold"
            android:textSize="20sp"
            android:id="@+id/noEncontrado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No se encontro productos"/>
    </RelativeLayout>


</LinearLayout>